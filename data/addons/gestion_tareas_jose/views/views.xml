      <field name="name">gestion_tareas_jose server</field>
      <field name="model_id" ref="model_gestion_tareas_jose_gestion_tareas_jose"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>
