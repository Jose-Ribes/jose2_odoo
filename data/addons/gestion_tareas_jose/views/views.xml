    <!-- Top menu item -->
    <menuitem name="Gestor Tareas" id="gestion_tareas_jose.menu_root"/>
    <!-- menu categories -->
    <menuitem name="Tareas" id="gestion_tareas_jose.tareas" parent="gestion_tareas_jose.menu_root" sequence="30"/>
    <menuitem name="Sprints" id="gestion_tareas_jose.sprints" parent="gestion_tareas_jose.menu_root" sequence="40"/>
    <menuitem name="Proyectos" id="gestion_tareas_jose.proyectos" parent="gestion_tareas_jose.menu_root" sequence="10"/>
    <menuitem name="Historias" id="gestion_tareas_jose.historias" parent="gestion_tareas_jose.menu_root" sequence="20"/>
    <menuitem name="Desarrolladores" id="gestion_tareas_jose.desarrolladores" action="desarrolladores_action_window" parent="gestion_tareas_jose.menu_root" sequence="50"/>
<!--
    <menuitem name="Menu 2" id="gestion_tareas_jose.menu_2" parent="gestion_tareas_jose.menu_root"/>
-->
    <!-- actions -->
    <menuitem name="List" id="gestion_tareas_jose.tareas_list" parent="gestion_tareas_jose.tareas"
              action="gestion_tareas_jose.action_tareas_window"/>
    <menuitem name="Listado Sprints" id="gestion_tareas_jose.sprints_list" parent="gestion_tareas_jose.sprints"
              action="gestion_tareas_jose.action_sprints_window"/>
    <menuitem name="Listado Proyectos" id="gestion_tareas_jose.proyectos_list" parent="gestion_tareas_jose.proyectos"
              action="gestion_tareas_jose.action_proyectos_window"/>
    <menuitem name="Listado Historias" id="gestion_tareas_jose.historias_list" parent="gestion_tareas_jose.historias"
              action="gestion_tareas_jose.action_historias_window"/>
<!--
    <menuitem name="Listado Desarrolladores" id="gestion_tareas_jose.desarrolladores_list" parent="gestion_tareas_jose.desarrolladores"
              action="gestion_tareas_jose.action_desarrolladores_window"/>
-->
