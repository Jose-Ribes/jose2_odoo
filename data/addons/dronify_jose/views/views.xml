<odoo>
  <data>

    <!-- ========================================================== -->
    <!-- VISTAS DE PILOTOS Y CLIENTES (res.partner)                 -->
    <!-- ========================================================== -->

    <!-- Vista formulario: Pilotos -->
    <record model="ir.ui.view" id="dronify_jose.pilotos_form">
      <field name="name">dronify_jose.pilotos_jose.form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='website']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='function']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr="//page[@name='sales_purchases']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='internal_notes']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='contact_addresses']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//sheet" position="inside">
          <group string="ROLES EN DRONIFY">
            <group>
              <field name="es_piloto" readonly="1"/>
              <field name="licencia" required="es_piloto"/>
              <field name="dron_autorizado_ids" widget="many2many_tags"/>
            </group>
            <group>
            <field name="es_cliente"/>
            <field name="es_vip" invisible="not es_cliente"/>
            </group>
          </group>
        </xpath>
      </field>
    </record>

    <!-- Vista formulario: Clientes -->
    <record model="ir.ui.view" id="dronify_jose.clientes_form">
      <field name="name">dronify_jose.clientes_jose.form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='website']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='function']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr="//page[@name='sales_purchases']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='internal_notes']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='contact_addresses']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//sheet" position="inside">
          <group string="ROLES EN DRONIFY">
            <group>
              <field name="es_cliente" readonly="1"/>
              <field name="es_vip" invisible="not es_cliente"/>
            </group>
            <group>
            <field name="es_piloto"/>
            <field name="licencia" required="es_piloto" invisible="not es_piloto"/>
            </group>
          </group>
        </xpath>
      </field>
    </record>

    <!-- ========================================================== -->
    <!-- VISTAS DE DRONES                                           -->
    <!-- ========================================================== -->

    <!-- Vista lista: Drones (con decoraciones por batería y estado) -->
    <record model="ir.ui.view" id="dronify_jose.drones_list">
      <field name="name">dronify_jose.drones_jose.list</field>
      <field name="model">dronify_jose.drones_jose</field>
      <field name="arch" type="xml">
          <list decoration-danger="bateria &lt; 25">
          <field name="name"/>
          <field name="capacidad_max"/>
            <field name="bateria" widget="progressbar"/>
            <field name="estado" widget="badge" decoration-success="estado == 'disponible'" decoration-warning="estado == 'vuelo'" decoration-danger="estado == 'taller'"/>
        </list>
      </field>
    </record>

    <!-- Vista formulario: Drones -->
    <record model="ir.ui.view" id="dronify_jose.drones_form">
      <field name="name">dronify_jose.drones_jose.form</field>
      <field name="model">dronify_jose.drones_jose</field>
      <field name="arch" type="xml">
          <form>
            <sheet>
              <group>
                <group>
                  <field name="name"/>
                  <field name="bateria"/>
                  </group>
                <group>
                  <field name="capacidad_max"/>
                  <field name="estado"/>
                </group>
                  <field name="piloto_autorizado_ids"/>
              </group>
            </sheet>
          </form>
      </field>
    </record>

    <!-- ========================================================== -->
    <!-- VISTAS DE VUELOS                                           -->
    <!-- ========================================================== -->

    <!-- Vista lista: Vuelos -->
    <record model="ir.ui.view" id="dronify_jose.vuelos_list">
      <field name="name">dronify_jose.vuelos_jose.list</field>
      <field name="model">dronify_jose.vuelos_jose</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="dron_id"/>
          <field name="piloto_id"/>
          <field name="peso_total"/>
          <field name="consumo_estimado"/>
          <field name="preparado" widget="boolean_toggle" class="text-center"/>
          <field name="realizado" widget="boolean_toggle" class="text-center"/>
        </list>
      </field>
    </record>

    <!-- Vista formulario: Vuelos -->
    <record model="ir.ui.view" id="dronify_jose.vuelos_form">
      <field name="name">dronify_jose.vuelos_jose.form</field>
      <field name="model">dronify_jose.vuelos_jose</field>
      <field name="arch" type="xml">
        <form>
            <header>
              <!-- Botón Preparar Vuelo: visible cuando NO está preparado y NO está realizado -->
              <button name="action_preparar_vuelo" 
                      string="Preparar Vuelo" 
                      type="object" 
                      class="oe_highlight"
                      invisible="preparado or realizado"/>
              
              <!-- Botón Desbloquear: visible cuando SÍ está preparado y NO está realizado -->
              <button name="action_desbloquear" 
                      string="Desbloquear" 
                      type="object"
                      invisible="not preparado or realizado"/>
              
              <!-- Botón Finalizar Vuelo: visible cuando SÍ está preparado y NO está realizado -->
              <button name="action_finalizar_vuelo" 
                      string="Finalizar Vuelo" 
                      type="object" 
                      class="oe_highlight"
                      invisible="not preparado or realizado"/>
            </header>
            <sheet>
              <group>
                <group string="PLANIFICACIÓN">
                  <field name="name"/>
                  <field name="dron_id"/>
                  <field name="piloto_id"/>
                </group>
                <group string="ESTADO Y CONTROL">
                  <field name="preparado" readonly="1"/>
                  <field name="realizado" readonly="1"/>
                </group>
              </group>
              <notebook>
                <page name="Paquetes">
                  <field name="paquetes_ids" readonly="preparado">
                    <form>
                      <group>
                        <field name="codigo"/>
                        <field name="name"/>
                        <field name="peso"/>
                        <field name="cliente_id"/>
                        <field name="vuelo_id"/>
                        <field name="dron_relacionado"/>
                      </group>
                    </form>
                  </field>
                  <group class="oe_subtotal_footer oe_right">
                    <field name="peso_total" readonly="1"/>
                    <field name="consumo_estimado" readonly="1"/>
                  </group>
                </page>
              </notebook>
            </sheet>
          </form>
      </field>
    </record>

    <!-- ========================================================== -->
    <!-- VISTAS DE PAQUETES                                         -->
    <!-- ========================================================== -->

    <!-- Vista lista: Paquetes -->
    <record model="ir.ui.view" id="dronify_jose.paquetes_list">
      <field name="name">dronify_jose.paquetes_jose.list</field>
      <field name="model">dronify_jose.paquetes_jose</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="peso"/>
          <field name="cliente_id"/>
          <field name="vuelo_id"/>
          <field name="dron_relacionado"/>
        </list>
      </field>
    </record>

    <!-- ========================================================== -->
    <!-- ACCIONES DE VENTANA (act_window)                           -->
    <!-- ========================================================== -->

    <!-- Acción: Pilotos -->
    <record model="ir.actions.act_window" id="dronify_jose.action_pilotos_window">
      <field name="name">Gestión de Pilotos</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('es_piloto', '=', True)]</field>
      <field name="context">{'default_es_piloto': True}</field>
    </record>

    <record model="ir.actions.act_window.view" id="dronify_jose.action_view_pilotos_list">
      <field name="sequence" eval="1"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="dronify_jose.action_pilotos_window"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_view_pilotos_form">
    <field name="sequence" eval="2"></field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="dronify_jose.pilotos_form"></field>
    <field name="act_window_id" ref="dronify_jose.action_pilotos_window"></field>
    </record>

    <!-- Acción: Clientes -->
    <record model="ir.actions.act_window" id="dronify_jose.action_clientes_window">
      <field name="name">Gestión de Clientes</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('es_cliente', '=', True)]</field>
      <field name="context">{'default_es_cliente': True}</field>
    </record>

    <record model="ir.actions.act_window.view" id="dronify_jose.action_view_clientes_list">
      <field name="sequence" eval="1"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="dronify_jose.action_clientes_window"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_view_clientes_form">
    <field name="sequence" eval="2"></field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="dronify_jose.clientes_form"></field>
    <field name="act_window_id" ref="dronify_jose.action_clientes_window"></field>
    </record>

    <!-- Acción: Drones -->
    <record model="ir.actions.act_window" id="dronify_jose.action_drones_window">
      <field name="name">Gestión de Drones</field>
      <field name="res_model">dronify_jose.drones_jose</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Acción: Vuelos -->
    <record model="ir.actions.act_window" id="dronify_jose.action_vuelos_window">
      <field name="name">Gestión de Vuelos</field>
      <field name="res_model">dronify_jose.vuelos_jose</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Acción: Paquetes -->
    <record model="ir.actions.act_window" id="dronify_jose.action_paquetes_window">
      <field name="name">Gestión de Paquetes</field>
      <field name="res_model">dronify_jose.paquetes_jose</field>
      <field name="view_mode">list</field>
    </record>

    <!-- ========================================================== -->
    <!-- MENÚS DE NAVEGACIÓN                                        -->
    <!-- ========================================================== -->

    <!-- Menú principal -->
    <menuitem name="Dronify Jose" id="dronify_jose.menu_root"/>
    
    <!-- Submenús -->
    <menuitem name="Pilotos" id="dronify_jose.menu_pilotos" parent="menu_root"
              action="dronify_jose.action_pilotos_window"/>
    <menuitem name="Clientes" id="dronify_jose.menu_clientes" parent="menu_root"
              action="dronify_jose.action_clientes_window"/>  
    <menuitem name="Drones" id="dronify_jose.menu_drones" parent="menu_root"
              action="dronify_jose.action_drones_window"/>
    <menuitem name="Vuelos" id="dronify_jose.menu_vuelos" parent="menu_root"
              action="dronify_jose.action_vuelos_window"/>
    <menuitem name="Paquetes" id="dronify_jose.menu_paquetes" parent="menu_root"
              action="dronify_jose.action_paquetes_window"/>
  </data>
</odoo>
