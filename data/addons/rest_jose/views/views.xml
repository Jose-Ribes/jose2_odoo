<odoo>
  <data>
    <!-- vista de lista (platos) -->
    <record model="ir.ui.view" id="rest_jose.list">
      <field name="name">rest_jose list</field>
      <field name="model">rest_jose.platos_jose</field>
      <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="categoria_id"/>
            <field name="chef_especializado"/>
            <field name="especialidad_chef"/>
            <field name="precio"/>
            <field name="disponible"/>
            <field name="codigo_plato"/>
            <field name="tiempo_preparacion"/>
            <field name="fecha_alta"/>
            <field name="precio_con_iva"/>
            <field name="precio_final"/>
        </list>
      </field>
    </record>

    <!-- vista de formulario (platos) -->
    <record model="ir.ui.view" id="rest_jose.form">
      <field name="name">rest_jose form</field>
      <field name="model">rest_jose.platos_jose</field>
      <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="codigo_plato"/>
                    <field name="name"/>
                    <field name="categoria_id"/>
                    <field name="chef_especializado"/>
                    <field name="especialidad_chef"/>
                    <field name="precio"/>
                    <field name="descuento"/>
                    <field name="precio_con_iva"/>
                    <field name="precio_final"/>
                    <field name="tiempo_preparacion"/>
                    <field name="fecha_alta"/>
                    <field name="menus" widget="many2many_tags"/>
                    <field name="disponible"/>
                    <field name="rel_ingredientes" widget="many2many_tags"/>
                </group>
            </sheet>
        </form>
      </field>
    </record>

      <!-- vista de lista (menús) -->
      <record model="ir.ui.view" id="rest_jose.menu_list">
        <field name="name">rest_jose menu list</field>
        <field name="model">rest_jose.menu_jose</field>
        <field name="arch" type="xml">
          <list>
          <field name="name"/>
          <field name="fecha_inicio"/>
          <field name="fecha_fin"/>
          <field name="activo"/>
          <field name="categorias_platos" widget="many2many_tags"/>
          <field name="platos" widget="many2many_tags"/>
          <field name="precio_total" readonly="1"/>
          </list>
        </field>
      </record>

      <!-- vista de formulario (menús) -->
      <record model="ir.ui.view" id="rest_jose.menu_form">
        <field name="name">rest_jose menu form</field>
        <field name="model">rest_jose.menu_jose</field>
        <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                  <group string="Información del menú">
                    <field name="name"/>
                    <field name="descripcion"/>
                    <field name="creado_por"/>
                    <field name="fecha_inicio"/>
                    <field name="dias_disponible"/>
                    <field name="fecha_fin"/>
                    <field name="activo"/>
                    <field name="categorias_platos" widget="many2many_tags"/>
                  </group>
                  <group string="Importe">
                    <field name="precio_total" readonly="1"/>
                  </group>
                </group>
                <group string="Platos del menú">
                  <field name="platos" widget="many2many_tags"/>
                </group>
            </sheet>
        </form>
        </field>
      </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="rest_jose.action_platos_window">
      <field name="name">Gestión de Platos</field>
      <field name="res_model">rest_jose.platos_jose</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="rest_jose.action_menus_window">
      <field name="name">Gestión de Menús</field>
      <field name="res_model">rest_jose.menu_jose</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="rest_jose.action_ingredientes_window">
      <field name="name">Gestión de Ingredientes</field>
      <field name="res_model">rest_jose.ingrediente_jose</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="rest_jose.action_categorias_window">
      <field name="name">Gestión de Categorías</field>
      <field name="res_model">rest_jose.categoria_jose</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="rest_jose.action_chefs_window">
      <field name="name">Gestión de Chefs</field>
      <field name="res_model">rest_jose.chef_jose</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- server action to the one above -->
<!--
    <record model="ir.actions.server" id="rest_jose.action_server">
      <field name="name">rest_jose server</field>
      <field name="model_id" ref="model_rest_jose_rest_jose"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->
    <menuitem name="Gestión Restaurante" id="rest_jose.menu_root"/>
    <!-- menu categories -->
    <menuitem name="Menu" id="rest_jose.menu" parent="rest_jose.menu_root" action="rest_jose.action_menus_window"/>
    <!-- <menuitem name="Menu 2" id="rest_jose.menu_2" parent="rest_jose.menu_root"/> -->
    <!-- actions -->
    <menuitem name="Platos" id="rest_jose.menu_platos" parent="rest_jose.menu"
          action="rest_jose.action_platos_window"/>
    <menuitem name="Menús" id="rest_jose.menu_menus" parent="rest_jose.menu"
          action="rest_jose.action_menus_window"/>
    <menuitem name="Ingredientes" id="rest_jose.menu_ingredientes" parent="rest_jose.menu"
          action="rest_jose.action_ingredientes_window"/>
    <menuitem name="Categorías" id="rest_jose.menu_categorias" parent="rest_jose.menu"
          action="rest_jose.action_categorias_window"/>
    <menuitem name="Chefs" id="rest_jose.menu_chefs" parent="rest_jose.menu"
          action="rest_jose.action_chefs_window"/>
  </data>
</odoo>
